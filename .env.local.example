# Copiar a .env.local para desarrollo local (con Docker corriendo:
# docker compose up db -d) o a .env en el VPS para producción.

# Debe coincidir con POSTGRES_PASSWORD en docker-compose.yml (variable
# DB_PASSWORD del entorno donde corra docker compose).
DB_PASSWORD=

# Desarrollo local (Postgres en Docker, puerto expuesto en localhost):
DATABASE_URL=postgres://laplace:CAMBIA_ESTO@localhost:5432/laplace

# Dominio real, solo hace falta en el VPS (Caddy lo usa para pedir el
# certificado HTTPS automáticamente). En local no se usa.
DOMINIO=
